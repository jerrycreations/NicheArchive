# Copy this file to .env.local and fill in the blanks. Add the same values to
# Vercel under Project -> Settings -> Environment Variables.
#
# To generate a random secret, use either:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Database (Supabase) ----------------------------------------------------
# Used by the app. Supabase -> Connect -> Transaction pooler (port 6543).
# Put your database password in place of [YOUR-PASSWORD], URL-encoded if it
# has special characters.
DATABASE_URL=
# Used only by drizzle-kit migrations. Supabase -> Connect -> Session pooler
# (port 5432), which handles schema changes reliably and works over IPv4.
# Add ?sslmode=require to the end so migrations are encrypted too (the app's
# own connection always requires SSL).
DATABASE_MIGRATION_URL=

# --- YouTube ----------------------------------------------------------------
# Google Cloud Console -> enable "YouTube Data API v3" -> Credentials ->
# Create API key, restricted to that API.
YOUTUBE_API_KEY=

# --- Gemini -----------------------------------------------------------------
# Google AI Studio -> Get API key (free tier).
GOOGLE_GENERATIVE_AI_API_KEY=
# Model names change often; check them against AI Studio's model list.
# Chat answers and video transcription.
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Rewrites follow-up questions before library search.
GEMINI_REWRITE_MODEL=gemini-3.5-flash-lite
# Embeddings for library search.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Must stay 768: the database's vector column has that fixed size.
EMBEDDING_DIMENSIONS=768

# --- Vercel Cron ------------------------------------------------------------
# Protects the daily database keep-alive. Vercel sends it automatically as a
# Bearer token when this variable is set. Generate a random value (see above).
CRON_SECRET=
